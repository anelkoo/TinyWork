<Project Sdk="Godot.NET.Sdk/4.7.2">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <RootNamespace>TinyWorks</RootNamespace>
    <Nullable>disable</Nullable>
    <!-- No ICU needed: English-only UI, and minimal Linux installs don't ship libicu. -->
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <!-- Local mod files next to the project, not part of the game. -->
  <ItemGroup>
    <Compile Remove="FunnyFoxy/**" />
  </ItemGroup>
</Project>
